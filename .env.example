# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Доступы к API СДЭК (ЛК → Интеграция → Ключи API)
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# 1 = тестовый контур api.edu.cdek.ru (если ключи пустые — берутся публичные тестовые)
CDEK_TEST=1

# Telegram ID пользователей через запятую, кому разрешён доступ (пусто = всем!)
ALLOWED_USERS=

# 1 = шаблоны общие для всех пользователей бота (команда), 0 = личные
SHARED_TEMPLATES=0

# Если api.telegram.org недоступен с сервера — адрес Cloudflare Worker (deploy/cloudflare-worker.js)
# TELEGRAM_API_URL=https://tg-proxy.ваш-аккаунт.workers.dev
# ...или прокси: socks5://user:pass@host:1080 либо http://host:3128
# TELEGRAM_PROXY=

DB_PATH=cdek_bot.sqlite3
# REDIS_URL=redis://localhost:6379/0
